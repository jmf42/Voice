# Shared
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Must be explicitly set to 'true' to enable dev auth tokens (defaults to false even in development)
ALLOW_DEV_AUTH_TOKEN=true
ALLOW_INMEMORY_STORE=true
STORE_MODE=memory
QUEUE_MODE=memory
VOICE_FLOW_MODE=guided
REALTIME_AGENT_MODEL=gpt-realtime-1.5

# Web
VITE_API_BASE_URL=http://localhost:4000
VITE_DEV_AUTH_TOKEN=tenant:demo-tenant:role:operator:user:1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Postgres/Redis
DATABASE_URL=postgresql://dispatch:dispatch@localhost:5432/dispatchos
REDIS_URL=redis://localhost:6379

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+41000000000

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Firebase Admin (API token verification)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/calendar/google/callback
